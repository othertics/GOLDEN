# =============================================================================
# Files that should not enter version control.
# =============================================================================

# --- Data -------------------------------------------------------------------
# Input matrices, simulation outputs and Vartrix tables are large and, in the
# case of patient-derived data, not redistributable. They are obtained
# separately; see README.
data/*
!data/.gitkeep
!data/README.txt
!data/geneInfo.tab
vartrix/VartrixRunOut/
vartrix/Alt_Sum_Results/

# Simulation artefacts, in case they are ever written outside data/
*.h5ad
*.mtx
*.mtx.gz
synthetic_ST_seed*
labels_generation_*.p
counts_generation_*.p
labels_validation_*.p
counts_validation_*.p
cellranger_format_seed*/
simulation_statistics_summary.csv

# --- Internal notes, not for publication ------------------------------------
# Working document listing discrepancies between the manuscript and the code.
docs/methods_corrections.md

# --- Run logs ---------------------------------------------------------------
*.out
*.err
*.log

# --- Figures ----------------------------------------------------------------
# Generated by steps 6 and 7 on every run.
*.png
*.pdf
*.svg

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Notebooks --------------------------------------------------------------
# Strip outputs before committing a notebook: cell outputs embed images and
# inflate the repository.
.ipynb_checkpoints/

# --- OS and editors ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
